# ==============================================================================
# EDOTHON ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate the values for your deployment.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Event Schedule (ISO 8601 with IST UTC+05:30 offset)
NEXT_PUBLIC_HACKATHON_START_DATE=2026-10-17T09:00:00+05:30
NEXT_PUBLIC_HACKATHON_END_DATE=2026-10-18T09:00:00+05:30
NEXT_PUBLIC_REGISTRATION_FEE=200

# Edobase Platform Integration (Swappable Realtime Database)
# When left empty, the built-in file-based storage adapter is used seamlessly.
EDOBASE_API_URL=https://api.edobase.io/v1
EDOBASE_PROJECT_ID=edothon_live_2026
EDOBASE_API_KEY=your_edobase_service_role_key_here

# Payee Payment Gateway Integration
# Real Payee credentials to be set in production
PAYEE_API_KEY=payee_live_key_placeholder
PAYEE_WEBHOOK_SECRET=payee_webhook_secret_placeholder
PAYEE_CHECKOUT_URL=https://checkout.payee.dev

# Email Provider Configuration ("mock" | "resend" | "nodemailer")
# Default "mock" outputs beautifully formatted emails directly to server logs for testing
EMAIL_PROVIDER=mock
EMAIL_FROM="Edothon Team <team@edothon.dev>"

# If EMAIL_PROVIDER=resend:
RESEND_API_KEY=re_placeholder_key

# If EMAIL_PROVIDER=nodemailer:
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=smtp_password_placeholder
